# Deploy settings for `pnpm run deploy` (alchemy.run.ts, infra/settings.ts). Copy to .env (git-ignored); shell
# variables override it. Cloudflare credentials are not set here: run `pnpm exec alchemy profile edit --add Cloudflare`
# once (or set CLOUDFLARE_ACCOUNT_ID + CLOUDFLARE_API_TOKEN in CI).

# Custom hostname of the proxy; its zone must already be in the Cloudflare account.
CLIPROXY_DOMAIN=proxy.example.com
# Zero Trust team name (myteam) or domain (myteam.cloudflareaccess.com).
ACCESS_TEAM_DOMAIN=myteam

# Who may pass Access (comma separated). People log in with your identity provider...
ACCESS_ALLOW_EMAILS=you@example.com
ACCESS_ALLOW_EMAIL_DOMAINS=
# ...tools use service tokens: one per client/machine, created by the deploy. Their credentials are written to
# .alchemy/access-service-tokens.json on the deploying machine.
ACCESS_SERVICE_TOKENS=claude-code,codex

# Management admins (/v8/management, /management.html): emails, and service token names from above or Client IDs.
ACCESS_ADMIN_EMAILS=you@example.com
ACCESS_ADMIN_SERVICE_TOKENS=

# Optional
# ACCESS_SESSION_DURATION=24h
# Single-header service tokens: Access reads {"cf-access-client-id": ..., "cf-access-client-secret": ...} from this header.
# ACCESS_SERVICE_TOKEN_HEADER=x-api-key
# Use an Access application managed outside this stack instead (its AUD tag); ACCESS_ALLOW_* and
# ACCESS_SERVICE_TOKENS are then ignored/rejected.
# ACCESS_AUD=
# USAGE_RETENTION_DAYS=30
# META_MINT_URL=
# CPU limit per request in ms (Workers Paid; lower it on plans with smaller limits).
# CLIPROXY_CPU_MS=300000

# `pnpm dev` only: identity of the local admin (every localhost request is treated as this user).
# ACCESS_DEV_BYPASS=dev@example.com
