  {
    "name": "request: function responses grouped FIFO, names backfilled, sibling inline data attached",
    "from": "gemini",
    "to": "antigravity",
    "model": "gemini-3-flash",
    "stream": false,
    "request": {
      "contents": [
        {
          "role": "user",
          "parts": [
            {
              "text": "go"
            }
          ]
        },
        {
          "role": "model",
          "parts": [
            {
              "functionCall": {
                "name": "first",
                "args": {
                  "a": 1
                }
              }
            },
            {
              "functionCall": {
                "name": "second",
                "args": {}
              }
            }
          ]
        },
        {
          "role": "user",
          "parts": [
            {
              "functionResponse": {
                "name": "",
                "response": {
                  "ok": true
                }
              }
            },
            {
              "inline_data": {
                "mime_type": "image/jpeg",
                "data": "AAAA"
              }
            }
          ]
        },
        {
          "role": "user",
          "parts": [
            {
              "text": "dropped with responses"
            },
            {
              "functionResponse": {
                "name": "second",
                "response": {
                  "ok": 2
                }
              }
            }
          ]
        },
        {
          "role": "model",
          "parts": [
            {
              "text": "done"
            }
          ]
        },
        "not an object",
        {
          "role": "user",
          "parts": [
            {
              "text": "again"
            }
          ]
        }
      ]
    }
  },
