    "name": "request: allowed_tools choice filters tools",
    "from": "openai",
    "to": "claude",
    "model": "claude-sonnet-4-5-20250929",
    "stream": false,
    "request": {
      "model": "gpt-4o",
      "messages": [
        {
          "role": "user",
          "content": "x"
        }
      ],
      "tools": [
        {
          "type": "function",
          "function": {
            "name": "a.b",
            "parameters": {
              "type": "object"
            }
          }
        },
        {
          "type": "function",
          "function": {
            "name": "c"
          }
        }
      ],
      "tool_choice": {
        "type": "allowed_tools",
        "allowed_tools": {
          "mode": "required",
          "tools": [
            {
              "type": "function",
              "function": {
                "name": "a.b"
              }
            }
          ]
        }
      }
    }
  },
