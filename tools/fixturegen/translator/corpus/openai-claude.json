[
  {
    "name": "request: simple user message with sampling and stop",
    "from": "openai",
    "to": "claude",
    "model": "claude-sonnet-4-5-20250929",
    "stream": true,
    "request": {
      "model": "gpt-4o",
      "messages": [
        {
          "role": "user",
          "content": "Hello"
        }
      ],
      "max_tokens": 256,
      "top_p": 0.9,
      "stop": ["END", "STOP"],
      "user": "u-1"
    }
  },
  {
    "name": "request: system, developer, multi-turn with tools and results",
    "from": "openai",
    "to": "claude",
    "model": "claude-sonnet-4-5-20250929",
    "stream": false,
    "request": {
      "model": "gpt-4o",
      "messages": [
        {
          "role": "system",
          "content": "You are a weather bot."
        },
        {
          "role": "developer",
          "content": [
            {
              "type": "text",
              "text": "Be terse."
            }
          ]
        },
        {
          "role": "user",
          "content": "Weather in Paris & Rome?"
        },
        {
          "role": "assistant",
          "content": "Checking.",
          "tool_calls": [
            {
              "id": "call_1",
              "type": "function",
              "function": {
                "name": "get_weather",
                "arguments": "{\"city\":\"Paris\"}"
              }
            },
            {
              "id": "call_2",
              "type": "function",
              "function": {
                "name": "mcp.tool:x",
                "arguments": "[1,2]"
              }
            },
            {
              "id": "call_3",
              "type": "function",
              "function": {
                "name": "bad_args",
                "arguments": "not json"
              }
            }
          ]
        },
        {
          "role": "tool",
          "tool_call_id": "call_1",
          "content": "Sunny, 21C"
        },
        {
          "role": "tool",
          "tool_call_id": "call_2",
          "content": [
            {
              "type": "text",
              "text": "part one"
            },
            "part two"
          ]
        },
        {
          "role": "tool",
          "tool_call_id": "call_2",
          "content": "duplicate wins last"
        },
        {
          "role": "tool",
          "tool_call_id": "call_3",
          "content": {
            "type": "text",
            "text": "obj"
          }
        },
        {
          "role": "user",
          "content": "Thanks"
        }
      ],
      "tools": [
        {
          "type": "function",
          "function": {
            "name": "get_weather",
            "description": "Get weather",
            "parameters": {
              "type": "object",
              "properties": {
                "city": {
                  "type": "string"
                }
              },
              "required": ["city"]
            },
            "strict": true
          }
        },
        {
          "type": "function",
          "function": {
            "name": "mcp.tool:x",
            "parameters": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "b": {
                      "type": "number"
                    },
                    "a": {
                      "type": "string"
                    }
                  }
                },
                {
                  "type": "string"
                }
              ],
              "properties": {
                "z": {
                  "type": "integer"
                }
              }
            }
          }
        },
        {
          "type": "web_search"
        }
      ],
      "tool_choice": "required",
      "parallel_tool_calls": false,
      "max_completion_tokens": 2048
    }
  },
  {
    "name": "request: images, files and cache control",
    "from": "openai",
    "to": "claude",
    "model": "claude-sonnet-4-5-20250929",
    "stream": false,
    "request": {
      "model": "gpt-4o",
      "messages": [
        {
          "role": "system",
          "content": [
            {
              "type": "text",
              "text": "Cached system",
              "cache_control": {
                "type": "ephemeral"
              }
            }
          ]
        },
        {
          "role": "user",
          "content": [
            {
              "type": "text",
              "text": "Look at this",
              "cache_control": {
                "type": "ephemeral"
              }
            },
            {
              "type": "image_url",
              "image_url": {
                "url": "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNkYPhfDwAChwGA60e6kgAAAABJRU5ErkJggg=="
              }
            },
            {
              "type": "image_url",
              "image_url": {
                "url": "https://example.com/cat.jpg"
              }
            },
            {
              "type": "file",
              "file": {
                "file_data": "data:application/pdf;base64,JVBERi0="
              }
            }
          ]
        },
        {
          "role": "assistant",
          "content": [
            {
              "type": "text",
              "text": "I see."
            }
          ],
          "cache_control": {
            "type": "ephemeral"
          }
        }
      ]
    }
  },
