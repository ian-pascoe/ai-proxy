{
  // Deploy-time code (alchemy.run.ts, infra/) runs in Node.js under the Alchemy CLI, not in workerd.
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": ".tsbuild/tsconfig.infra.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["alchemy.run.ts", "infra"]
}
