{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": ".tsbuild/tsconfig.worker.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node", "./worker-configuration.d.ts", "@cloudflare/vitest-plugin/types"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src",
    "test",
    "tools/panel-sync",
    "web/src/lib/accounts.ts",
    "web/src/lib/connect.ts",
    "web/src/lib/format.ts",
    "web/src/lib/history.ts",
    "web/src/lib/quota.ts",
    "web/src/lib/usage.ts",
    "worker-configuration.d.ts",
    "vitest.config.ts"
  ]
}
