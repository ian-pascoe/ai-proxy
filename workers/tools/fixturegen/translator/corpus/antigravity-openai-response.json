[
  {
    "name": "request: instructions, tools, function call history",
    "from": "openai-response",
    "to": "antigravity",
    "model": "gemini-3-pro-high",
    "stream": false,
    "request": {
      "model": "x",
      "instructions": "be brief",
      "reasoning": {
        "effort": "high"
      },
      "max_output_tokens": 500,
      "tools": [
        {
          "type": "function",
          "name": "get_weather",
          "description": "d",
          "parameters": {
            "type": "object",
            "properties": {
              "city": {
                "type": "string"
              }
            }
          }
        },
        {
          "type": "web_search"
        }
      ],
      "input": [
        {
          "type": "message",
          "role": "user",
          "content": [
            {
              "type": "input_text",
              "text": "hi"
            }
          ]
        },
        {
          "type": "function_call",
          "call_id": "c1",
          "name": "get_weather",
          "arguments": "{\"city\":\"Paris\"}"
        },
        {
          "type": "function_call_output",
          "call_id": "c1",
          "output": "sunny"
        },
        {
          "type": "message",
          "role": "user",
          "content": [
            {
              "type": "input_text",
              "text": "and Berlin?"
            }
          ]
        }
      ]
    }
  },
  {
    "name": "request: reasoning effort none keeps summary untouched",
    "from": "openai-response",
    "to": "antigravity",
    "model": "gemini-2.5-flash",
    "stream": false,
    "request": {
      "reasoning": {
        "effort": "none"
      },
      "input": "hello"
    }
  },
  {
    "name": "request: explicit summary visibility is kept",
    "from": "openai-response",
    "to": "antigravity",
