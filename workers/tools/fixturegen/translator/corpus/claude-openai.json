  {
    "name": "request: schema normalization (properties, boolean subschemas, unicode patterns)",
    "from": "claude",
    "to": "openai",
    "model": "gpt-4o",
    "stream": false,
    "request": {
      "model": "c",
      "tools": [
        {
          "name": "t",
          "description": "d",
          "input_schema": {
            "type": "object",
            "pattern": "^\\p{L}+$",
            "properties": {
              "a": true,
              "b": {
                "type": "object"
              },
              "c": {
                "type": "array",
                "items": true
              },
              "d": {
                "type": "string",
                "pattern": "\\p{Lu}"
              },
              "e": {
                "type": "object",
                "additionalProperties": true
              }
            },
            "patternProperties": {
              "\\p{L}": {
                "type": "string"
              },
              "^x": {
                "type": "object"
              }
            },
            "required": [
              "a"
            ],
            "additionalProperties": false
          }
        }
      ],
      "messages": [
        {
          "role": "user",
          "content": "hi"
        }
      ]
    }
  },
