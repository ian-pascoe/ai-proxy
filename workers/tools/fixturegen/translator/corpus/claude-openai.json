[
  {
    "name": "request: system, images, tools, tool_result, tool_choice and stop sequences",
    "from": "claude",
    "to": "openai",
    "model": "gpt-4o",
    "stream": true,
    "request": {
      "model": "claude-sonnet-4",
      "max_tokens": 1024,
      "temperature": 0.7,
      "stop_sequences": [
        "END",
        "<stop>"
      ],
      "system": [
        {
          "type": "text",
          "text": "You are helpful."
        },
        {
          "type": "text",
          "text": "x-anthropic-billing-header: cc_version=1;"
        }
      ],
      "messages": [
        {
          "role": "user",
          "content": [
            {
              "type": "text",
              "text": "What is in this image? <b>"
            },
            {
              "type": "image",
              "source": {
                "type": "base64",
                "media_type": "image/png",
                "data": "iVBORw0KGgo="
              }
            }
          ]
        },
        {
          "role": "assistant",
          "content": [
            {
              "type": "text",
              "text": "Let me check the weather."
            },
            {
              "type": "tool_use",
              "id": "toolu_01",
              "name": "get_weather",
              "input": {
                "city": "Paris",
                "units": "c"
              }
            }
          ]
        },
        {
          "role": "user",
          "content": [
            {
              "type": "tool_result",
              "tool_use_id": "toolu_01",
              "content": [
                {
                  "type": "text",
                  "text": "22C sunny"
                }
              ]
            },
            {
              "type": "text",
              "text": "Thanks, and tomorrow?"
            }
          ]
        }
      ],
      "tools": [
        {
          "name": "get_weather",
          "description": "Weather lookup",
          "input_schema": {
            "type": "object",
            "properties": {
              "city": {
                "type": "string"
              },
              "units": {
                "type": "string",
                "enum": [
                  "c",
                  "f"
                ]
              }
            },
            "required": [
              "city"
            ]
          }
        },
        {
          "name": "noop",
          "input_schema": {
            "type": "object"
          }
        }
      ],
      "tool_choice": {
        "type": "auto",
        "disable_parallel_tool_use": true
      },
      "user": "u-1"
    }
  },
