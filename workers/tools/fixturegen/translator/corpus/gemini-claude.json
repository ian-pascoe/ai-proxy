  {
    "name": "request: function calls and responses pair FIFO and by id",
    "from": "gemini",
    "to": "claude",
    "model": "claude-sonnet-4-5-20250929",
    "stream": false,
    "request": {
      "contents": [
        {
          "role": "user",
          "parts": [
            {
              "text": "Weather in two cities"
            }
          ]
        },
        {
          "role": "model",
          "parts": [
            {
              "text": "Looking"
            },
            {
              "functionCall": {
                "name": "get weather",
                "args": {
                  "city": "Paris"
                }
              }
            },
            {
              "functionCall": {
                "name": "get_weather",
                "args": {
                  "city": "Rome"
                },
                "id": "custom_1"
              }
            },
            {
              "thought": true,
              "text": "hidden"
            }
          ]
        },
        {
          "role": "function",
          "parts": [
            {
              "functionResponse": {
                "name": "get_weather",
                "response": {
                  "result": "Sunny"
                }
              }
            },
            {
              "functionResponse": {
                "name": "get_weather",
                "id": "custom_1",
                "response": {
                  "temp": 21,
                  "unit": "C"
                }
              }
            }
          ]
        },
        {
          "role": "tool",
          "parts": [
            {
              "functionResponse": {
                "name": "orphan",
                "response": {
                  "result": {
                    "a": 1
                  }
                }
              }
            }
          ]
        },
        {
          "role": "user",
          "parts": [
            {
              "text": "Thanks"
            }
          ]
        }
      ],
      "tools": [
        {
          "functionDeclarations": [
            {
              "name": "get weather",
              "description": "Get weather",
              "parameters": {
                "type": "OBJECT",
                "properties": {
                  "city": {
                    "type": "STRING"
                  },
                  "type": {
                    "type": "STRING"
                  },
                  "tags": {
                    "type": "ARRAY",
                    "items": {
                      "type": "STRING"
                    }
                  }
                },
                "required": ["city"]
              }
            },
            {
              "name": "plain"
            },
            {
              "name": "json_schema",
              "parametersJsonSchema": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": ["STRING", "NULL"]
                  }
                },
                "additionalProperties": true,
                "$schema": "other"
              }
            }
          ]
        },
        {
          "googleSearch": {}
        }
      ],
      "toolConfig": {
        "functionCallingConfig": {
          "mode": "ANY",
          "allowedFunctionNames": ["get weather"]
        }
      }
    }
  },
