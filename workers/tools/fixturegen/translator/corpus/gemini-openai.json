            "text": "hidden",
            "thought": true
          }
        ]
      },
      "generationConfig": {
        "temperature": 0.4,
        "maxOutputTokens": 512,
        "topP": 0.8,
        "topK": 40,
        "stopSequences": ["STOP", "<end>"],
