        "responseModalities": ["TEXT", "image", "Video"],
        "thinkingConfig": {
          "thinkingBudget": 4096,
          "includeThoughts": true
        }
      },
      "service_tier": "priority",
      "contents": [
        {
          "role": "user",
          "parts": [
            {
              "text": "Describe "
            },
