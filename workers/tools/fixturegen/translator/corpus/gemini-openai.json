              "inlineData": {
                "mimeType": "image/png",
                "data": "iVBORw0KGgo="
              }
            },
            {
              "fileData": {
                "mimeType": "application/pdf",
                "fileUri": "gs://bucket/a.pdf"
              }
            }
          ]
        },
        {
          "role": "model",
          "parts": [
            {
              "text": "thinking...",
              "thought": true
            },
            {
              "functionCall": {
                "name": "get_weather",
                "args": {
                  "city": "Paris"
                }
              }
            },
            {
              "functionCall": {
                "id": "call_x",
                "name": "get_weather",
                "args": {
                  "city": "Rome"
                }
              }
            }
          ]
        },
        {
          "role": "user",
          "parts": [
            {
              "functionResponse": {
                "name": "get_weather",
                "response": {
                  "content": {
                    "temp": 22
                  }
                }
              }
            },
            {
              "functionResponse": {
                "id": "call_x",
                "name": "get_weather",
                "response": {
                  "temp": 25
                }
              }
            },
            {
              "functionResponse": {
                "name": "other",
                "response": {
                  "ok": true
                }
              }
            }
          ]
        },
        {
          "role": "model",
          "parts": [
            {
              "text": "only thought",
              "thought": true
            }
          ]
        },
        {
          "role": "user",
          "parts": [
            {
              "text": "thanks"
            },
            {
              "inline_data": {
                "mime_type": "audio/wav",
                "data": "UklGRg=="
              }
            },
            {
              "file_data": {
                "mime_type": "text/plain",
                "file_uri": "https://example.com/a.txt"
              }
            },
            {
              "fileData": {
                "mimeType": "application/octet-stream",
                "fileUri": "gs://b/c"
              }
            }
          ]
        }
      ],
      "tools": [
        {
          "functionDeclarations": [
            {
              "name": "get_weather",
              "description": "Weather",
              "parameters": {
                "type": "OBJECT",
                "properties": {
                  "city": {
                    "type": "STRING"
                  }
                },
                "required": ["city"]
              }
            },
            {
              "name": "raw",
              "parametersJsonSchema": {
                "type": "object",
                "properties": {
                  "a": {
                    "type": "integer"
                  }
                }
              }
            }
          ]
        }
      ],
      "toolConfig": {
        "functionCallingConfig": {
          "mode": "ANY",
          "allowedFunctionNames": ["get_weather"]
        }
      }
    }
  },
