  {
    "name": "request: function and custom tool calls with outputs",
    "from": "openai-response",
    "to": "claude",
    "model": "claude-sonnet-4-5-20250929",
    "stream": false,
    "request": {
      "model": "gpt-5",
      "tools": [
        {
          "type": "function",
          "name": "get_weather",
          "description": "Get weather",
          "parameters": {
            "type": "object",
            "properties": {
              "city": {
                "type": "string"
              }
            },
            "required": ["city"]
          }
        },
        {
          "type": "custom",
          "name": "shell_cmd",
          "description": "Run a command"
        },
        {
          "type": "web_search",
          "external_web_access": true,
          "max_uses": 3,
          "filters": {
            "allowed_domains": ["a.com"]
          },
          "user_location": {
            "type": "approximate",
            "country": "US"
          }
        },
        {
          "type": "namespace",
          "name": "mcp__srv",
          "tools": [
            {
              "type": "function",
              "name": "lookup",
              "parameters": {
                "type": "object",
                "properties": {}
              }
            }
          ]
        },
        {
          "type": "image_generation"
        },
        {
          "type": "function",
          "name": "bad name!"
        }
      ],
      "tool_choice": {
        "type": "function",
        "name": "get_weather"
      },
      "input": [
        {
          "type": "message",
          "role": "user",
          "content": [
            {
              "type": "input_text",
              "text": "go"
            }
          ]
        },
        {
          "type": "reasoning",
          "encrypted_content": "opaque-not-claude",
          "summary": [
            {
              "type": "summary_text",
              "text": "thought"
            }
          ]
        },
        {
          "type": "function_call",
          "call_id": "call_1",
          "name": "get_weather",
          "arguments": "{\"city\":\"Paris\"}"
        },
        {
          "type": "custom_tool_call",
          "call_id": "call_2",
          "name": "shell_cmd",
          "input": "ls -la"
        },
        {
          "type": "function_call",
          "call_id": "call_3",
          "namespace": "mcp__srv",
          "name": "lookup",
          "arguments": "not json"
        },
        {
          "type": "function_call_output",
          "call_id": "call_1",
          "output": "Sunny"
        },
        {
          "type": "custom_tool_call_output",
          "call_id": "call_2",
          "output": [
            {
              "type": "input_text",
              "text": "file list"
            },
            {
              "type": "input_image",
              "image_url": "data:image/png;base64,CCCC"
            }
          ]
        },
        {
          "type": "function_call_output",
          "call_id": "orphan",
          "output": "standalone"
        },
        {
          "type": "message",
          "role": "user",
          "content": "thanks"
        }
      ]
    }
  },
