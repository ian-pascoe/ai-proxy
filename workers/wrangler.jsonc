{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cliproxy-workers",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  // Access is the only client authentication mechanism: never expose the Worker
  // on workers.dev or preview URLs (see docs/workers-port/ARCHITECTURE.md).
  "workers_dev": false,
  "preview_urls": false,

  // Cloudflare Access verification (see src/access). Empty defaults fail closed: protected routes answer 500 until
  // ACCESS_TEAM_DOMAIN and ACCESS_AUD are set. Override per environment with `wrangler secret`/dashboard vars.
  //   ACCESS_TEAM_DOMAIN: team name or domain, e.g. "myteam" or "myteam.cloudflareaccess.com"
  //   ACCESS_AUD: comma separated Access application AUD tags
  //   ACCESS_ADMIN_EMAILS / ACCESS_ADMIN_SERVICE_TOKENS: comma separated management admin allow-lists
  //   ACCESS_DEV_BYPASS: local `wrangler dev` only (set it in .dev.vars, never here); honoured for loopback hosts only
  "vars": {
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "ACCESS_ADMIN_EMAILS": "",
    "ACCESS_ADMIN_SERVICE_TOKENS": "",
    "ACCESS_DEV_BYPASS": ""
  },

  "observability": { "enabled": true },
  "limits": { "cpu_ms": 300000 },

  "durable_objects": {
    "bindings": [
      { "name": "CONTROL_PLANE", "class_name": "ControlPlane" },
      { "name": "SESSION_STATE", "class_name": "SessionState" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ControlPlane", "SessionState"] }],

  "kv_namespaces": [{ "binding": "CACHE", "id": "00000000000000000000000000000000" }],

  "d1_databases": [
    {
      "binding": "USAGE",
      "database_name": "cliproxy-usage",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],

  // Management control panel. The Worker runs first so proxy routes are never shadowed by assets.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  // Model catalog refresh (3 h like Go) and, later, the credential refresh safety sweep: see src/scheduled.ts.
  "triggers": { "crons": ["0 */3 * * *"] }
}
